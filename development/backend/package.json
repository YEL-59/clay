{
  "name": "shifatdevs-backend",
  "version": "1.0.0",
  "description": "Express.js REST API & Mongoose In-Memory/Atlas Backend for Raye Striped-Shirt Apparel Suite",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node init && tsx watch src/server.ts",
    "start:dev": "node init && tsx watch src/server.ts",
    "build": "node init && tsc",
    "start": "node init && node dist/server.js",
    "test": "jest --runInBand",
    "test:api": "jest test/api.test.ts --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.8.7",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
